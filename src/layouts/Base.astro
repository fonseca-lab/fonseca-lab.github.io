---
import { site } from '../data/site';

interface Props {
	title: string;
	pageTitle?: string;
	flush?: boolean;
}

const { title, pageTitle, flush = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="google-site-verification" content="NGVGrsKdgzybUNks-ZTxt3-Z90KYQAj1_a_OhwOCTyI" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={site.description} />
		<title>{title}</title>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="/css/main.css" />
	</head>
	<body>
		<header class="site-header">
			<div class="wrap mast">
				<a class="site-title" href="/">
					{site.labName}<span class="title-institution">  @  {site.institution}</span>
				</a>
				<nav class="site-nav" aria-label="Pages">
					<ul>
						{site.nav.map((item) => (
							<li>
								<a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</div>
		</header>

		<main class:list={['page', flush && 'flush']}>
			<div class="wrap">
				{pageTitle && <h1>{pageTitle}</h1>}
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<p>{site.description}</p>
			</div>
		</footer>
	</body>
</html>
